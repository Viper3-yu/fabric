# Copy this file to apps/api/.env (loaded automatically when ENV_FILE is not
# set) or point ENV_FILE at it. Every value below must be provided by the
# operator: the server ships no built-in credentials or secrets.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Required in every environment; generate e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Per-IP request cap for unauthenticated /api/public/ endpoints; 0 disables.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
# Only enable when a trusted reverse proxy (see deploy/nginx.conf) forwards
# X-Forwarded-For; otherwise clients spoof the header and bypass rate limits.
TRUST_PROXY=false

# Built-in role account credentials. Either form works per account; bcrypt
# hashes take precedence and are the only accepted production form. Generate
# a hash with:
#   go run ./apps/api/cmd/hash-password 'your-password'
# APP_PASSWORD_SHIPPER=replace-me
# APP_PASSWORD_CARRIER=replace-me
# APP_PASSWORD_RECEIVER=replace-me
# APP_PASSWORD_AUDITOR=replace-me
# APP_PASSWORD_HASH_SHIPPER=$2a$10$...bcrypt-hash...
# APP_PASSWORD_HASH_CARRIER=$2a$10$...
# APP_PASSWORD_HASH_RECEIVER=$2a$10$...
# APP_PASSWORD_HASH_AUDITOR=$2a$10$...

# Hyperledger Fabric Gateway connection. The network/bootstrap.ps1 and
# network/start.ps1 scripts write working local values into apps/api/.env.fabric.
FABRIC_CHANNEL_NAME=logisticschannel
FABRIC_CHAINCODE_NAME=logistics
FABRIC_CONNECTION_PROFILE_PATH=/absolute/path/to/connection-profile.json
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=/absolute/path/to/peer/tls/ca.crt
FABRIC_ORG1_MSP_ID=Org1MSP
FABRIC_ORG1_CERT_PATH=/absolute/path/to/org1/user/signcerts/cert.pem
FABRIC_ORG1_KEY_PATH=/absolute/path/to/org1/user/keystore/priv_sk
# Optional per-organization peer settings override the generic peer above.
# FABRIC_ORG1_PEER_ENDPOINT=localhost:7051
# FABRIC_ORG1_PEER_HOST_ALIAS=peer0.org1.example.com
# FABRIC_ORG1_TLS_CERT_PATH=/absolute/path/to/org1/peer/tls/ca.crt
FABRIC_ORG2_MSP_ID=Org2MSP
FABRIC_ORG2_CERT_PATH=/absolute/path/to/org2/user/signcerts/cert.pem
FABRIC_ORG2_KEY_PATH=/absolute/path/to/org2/user/keystore/priv_sk
# FABRIC_ORG2_PEER_ENDPOINT=localhost:9051
# FABRIC_ORG2_PEER_HOST_ALIAS=peer0.org2.example.com
# FABRIC_ORG2_TLS_CERT_PATH=/absolute/path/to/org2/peer/tls/ca.crt
