PORT=3001
HOST=127.0.0.1
LEDGER_MODE=demo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DEMO_LEDGER_PATH=./apps/api/data/demo-ledger.json
DEMO_AUTO_SEED=true

# Fabric Gateway mode
FABRIC_CHANNEL_NAME=logisticschannel
FABRIC_CHAINCODE_NAME=logistics
FABRIC_CONNECTION_PROFILE_PATH=/absolute/path/to/connection-profile.json
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=/absolute/path/to/peer/tls/ca.crt
FABRIC_ORG1_MSP_ID=Org1MSP
FABRIC_ORG1_CERT_PATH=/absolute/path/to/org1/user/signcerts/cert.pem
FABRIC_ORG1_KEY_PATH=/absolute/path/to/org1/user/keystore/priv_sk
# Optional per-organization peer settings override the generic peer above.
# FABRIC_ORG1_PEER_ENDPOINT=localhost:7051
# FABRIC_ORG1_PEER_HOST_ALIAS=peer0.org1.example.com
# FABRIC_ORG1_TLS_CERT_PATH=/absolute/path/to/org1/peer/tls/ca.crt
FABRIC_ORG2_MSP_ID=Org2MSP
FABRIC_ORG2_CERT_PATH=/absolute/path/to/org2/user/signcerts/cert.pem
FABRIC_ORG2_KEY_PATH=/absolute/path/to/org2/user/keystore/priv_sk
# FABRIC_ORG2_PEER_ENDPOINT=localhost:9051
# FABRIC_ORG2_PEER_HOST_ALIAS=peer0.org2.example.com
# FABRIC_ORG2_TLS_CERT_PATH=/absolute/path/to/org2/peer/tls/ca.crt
