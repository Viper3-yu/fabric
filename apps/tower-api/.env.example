PORT=8080
LEDGER_MODE=mock
# 设为 fabric 时连接统一 logistics 链码。可用 ENV_FILE 直接指向 apps/api/.env.fabric：
#   ENV_FILE=../../apps/api/.env.fabric LEDGER_MODE=fabric go run ./cmd/server
# TOWER_ORG 选择使用哪个组织的证书族（1=Org1MSP 发货侧，2=Org2MSP 承运侧），
# 优先读取 FABRIC_ORG{n}_* 变量，缺省回退到通用 FABRIC_* 变量。
TOWER_ORG=1
MYSQL_DSN=lianyun_app:lianyun_dev@tcp(127.0.0.1:3306)/lianyun?parseTime=true&loc=UTC
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=logisticschannel
FABRIC_CHAINCODE=logistics
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# 单独配置时按 fabric-samples 的 Org1 User1 证书目录填写；
# 与主 API 共用环境时直接用 ENV_FILE，无需逐项填写
FABRIC_CERT_PATH=/path/to/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=/path/to/User1@org1.example.com/msp/keystore/key.pem
FABRIC_TLS_CERT_PATH=/path/to/peer0.org1.example.com/tls/ca.crt
