{
  "name": "jixin",
  "version": "1.0.0",
  "private": true,
  "description": "迹信 - 基于 Hyperledger Fabric 的可信物流追踪系统",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "powershell -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "dev": "pnpm --filter @jixin/shared build && concurrently -k -n API,WEB -c blue,green \"go run ./apps/api/cmd/server\" \"pnpm --filter @jixin/web dev\"",
    "build": "pnpm -r build && go build ./apps/api/... ./chaincode/logistics/...",
    "test": "pnpm -r test && go test ./apps/api/... ./chaincode/logistics/...",
    "test:unit": "pnpm -r test:unit && go test ./apps/api/... ./chaincode/logistics/...",
    "test:closed-loop": "go test ./apps/api/internal/httpapi -run TestClosedLoop -count=1",
    "lint": "pnpm -r lint && go vet ./apps/api/... ./chaincode/logistics/...",
    "typecheck": "pnpm -r typecheck && go test ./apps/api/... ./chaincode/logistics/... -run ^$",
    "format": "prettier --write . && go fmt ./apps/api/... ./chaincode/logistics/...",
    "format:check": "prettier --check . && powershell -ExecutionPolicy Bypass -File scripts/check-go-format.ps1",
    "fabric:bootstrap": "powershell -ExecutionPolicy Bypass -File network/bootstrap.ps1",
    "fabric:up": "powershell -ExecutionPolicy Bypass -File network/start.ps1",
    "fabric:down": "powershell -ExecutionPolicy Bypass -File network/stop.ps1",
    "seed": "go run ./apps/api/cmd/seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
